# copy to .env (git-ignored) and adjust: `make env.init`
# read by the Makefile, docker compose and atlas.hcl. plain KEY=value only:
# no quotes, no `export`, no inline comments (make takes them literally).

# database engine for infra.* and atlas: postgres | mysql
DB_ENGINE=postgres

# local database credentials. they only seed a fresh volume, so after changing
# them run `make infra.reset` (mysql always connects as root)
DB_USER=user
DB_PASSWORD=passwd
DB_NAME=default

# target for `make migrate.* ATLAS_ENV=staging`, e.g.
# postgres://user:passwd@staging-host:5432/app?sslmode=require
# mysql://user:passwd@staging-host:3306/app?tls=true
STAGING_URL=
